SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# Development defaults. For production set all three to True behind HTTPS.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Use this only when a proxy/load balancer terminates HTTPS.
SECURE_PROXY_SSL_HEADER_NAME=
SECURE_PROXY_SSL_HEADER_VALUE=https

# Email / OTP delivery
# For local-only testing, use: django.core.mail.backends.console.EmailBackend
# For real OTP emails, keep SMTP backend below. SMTP 465 uses SSL.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.thewebfix.in
EMAIL_PORT=465
EMAIL_HOST_USER=ddtesting@thewebfix.in
EMAIL_HOST_PASSWORD=your-email-password-here
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=ddtesting@thewebfix.in
SERVER_EMAIL=ddtesting@thewebfix.in
EMAIL_TIMEOUT=20

# Optional demo seed passwords. Leave blank to generate random values.
DEMO_ADMIN_PASSWORD=
DEMO_REPORTER_PASSWORD=
DEMO_EDITOR_PASSWORD=
