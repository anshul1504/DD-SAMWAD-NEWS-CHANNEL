# Copy this file to .env and fill in real values. The defaults below are for
# LOCAL DEVELOPMENT. Lines marked "PRODUCTION:" show what to change when
# deploying for real -- see README.md's Production Notes section.

SECRET_KEY=change-me
# PRODUCTION: generate a real key and set DEBUG=False.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# PRODUCTION: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
SITE_URL=http://127.0.0.1:8000
# PRODUCTION: SITE_URL=https://yourdomain.com

# Security settings. Keep these off for local HTTP development.
# PRODUCTION: set all of these True once HTTPS is correctly configured.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Use this only when a proxy/load balancer terminates HTTPS.
# PRODUCTION (behind a proxy): SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
SECURE_PROXY_SSL_HEADER_NAME=
SECURE_PROXY_SSL_HEADER_VALUE=https

# Email / OTP delivery
# For local-only testing, use: django.core.mail.backends.console.EmailBackend
# For real OTP emails, keep SMTP backend below. SMTP 465 uses SSL.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sys19.prosuperservers.com
EMAIL_PORT=465
EMAIL_HOST_USER=info@ddsamvad.com
EMAIL_HOST_PASSWORD=your-email-password-here
# PRODUCTION: use the real, rotated mailbox password. Never commit it.
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=info@ddsamvad.com
SERVER_EMAIL=info@ddsamvad.com
EMAIL_TIMEOUT=20

# Optional: fixed password for the demo editor user created by
# `seed_home_demo`. Leave blank to generate a random one (printed to the
# console when the command runs).
DEMO_EDITOR_PASSWORD=

# --- Optional, only needed for specific features ---
# Redis cache (recommended for production; falls back to a DB-backed cache
# table when unset -- see `python manage.py createcachetable`).
REDIS_URL=
# Error tracking (Sentry). The app runs normally with this unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
# Comma-separated "Name <email>, Name2 <email2>" -- receives 500-error alerts.
ADMINS=
# Extra hosts allowed to POST here (needed behind some proxies/CDNs).
CSRF_TRUSTED_ORIGINS=
# Override where uploaded media is stored (defaults to <project>/media).
MEDIA_ROOT=
