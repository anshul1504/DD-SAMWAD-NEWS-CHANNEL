SECRET_KEY=replace-with-a-long-random-production-secret-key
DEBUG=False
ALLOWED_HOSTS=deshdarpansamvad.com,www.deshdarpansamvad.com
SITE_URL=https://deshdarpansamvad.com

# Enable these only after HTTPS is correctly configured for the production domain.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
# Use this only when a proxy/load balancer terminates HTTPS.
SECURE_PROXY_SSL_HEADER_NAME=HTTP_X_FORWARDED_PROTO
SECURE_PROXY_SSL_HEADER_VALUE=https

# Email / OTP delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.thewebfix.in
EMAIL_PORT=465
EMAIL_HOST_USER=ddtesting@thewebfix.in
EMAIL_HOST_PASSWORD=replace-with-rotated-mailbox-password
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=ddtesting@thewebfix.in
SERVER_EMAIL=ddtesting@thewebfix.in
EMAIL_TIMEOUT=20
